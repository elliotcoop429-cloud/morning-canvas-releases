{
  "name": "Morning Canvas \u2014 collaborative source editing",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vsliveshare.vsliveshare"
      ],
      "settings": {
        "liveshare.guestApprovalRequired": true,
        "liveshare.anonymousGuestApproval": "reject",
        "liveshare.shareExternalFiles": false,
        "liveshare.autoShareServers": false,
        "liveshare.autoShareTerminals": false,
        "liveshare.allowGuestDebugControl": false,
        "liveshare.languages.allowGuestCommandControl": false
      }
    }
  },
  "portsAttributes": {
    "8000": {
      "label": "Loading animation only",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
